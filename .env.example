# Copy to .env and adjust. Every value is optional — with no .env at all,
# the board runs in demo mode on the terminal.

# Your train API endpoint (see docs/api-contract.md). Unset = demo data.
#TRAIN_API_URL=http://localhost:8000/arrivals

# Seconds between polls.
#POLLING_INTERVAL=15

# auto | api | demo        (auto: api when TRAIN_API_URL is set)
#MATRIX_SOURCE=auto

# auto | hardware | terminal   (auto: hardware when rgbmatrix is importable)
#MATRIX_DRIVER=auto

# auto | pi-zero-2w | pi-3 | pi-4   (see docs/hardware-tuning.md)
#MATRIX_HARDWARE_PROFILE=auto

# Single-value overrides on top of the profile:
#MATRIX_BRIGHTNESS=40
#MATRIX_GPIO_SLOWDOWN=3
#MATRIX_PWM_BITS=8
#MATRIX_PWM_LSB_NANOSECONDS=130
#MATRIX_REFRESH_RATE_LIMIT=120